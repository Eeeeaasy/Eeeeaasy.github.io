      repeating-radial-gradient(circle at 50% 50%, rgba(255,244,217,0.11) 15.6%, rgba(255,244,217,0.11) 15.8%, rgba(0,0,0,0) 15.8%, rgba(0,0,0,0) 16.46%),
      repeating-radial-gradient(circle at 50% 50%, rgba(0,0,0,0.54) 16.48%, rgba(0,0,0,0.54) 16.7%, rgba(0,0,0,0) 16.7%, rgba(0,0,0,0) 17.38%),
      repeating-radial-gradient(circle at 50% 50%, rgba(255,220,160,0.042) 16.72%, rgba(255,220,160,0.042) 16.8%, rgba(0,0,0,0) 16.8%, rgba(0,0,0,0) 17.36%),
      repeating-conic-gradient(from 0deg at 50% 50%, rgba(255,230,176,0.018) 0deg 0.36deg, rgba(0,0,0,0) 0.36deg 1.5deg),
      radial-gradient(150% 130% at 50% 120%, rgba(40,34,24,0.15), rgba(0,0,0,0) 62%);
      box-shadow: inset 0 0 0 1px rgba(255,240,210,0.1), inset 0 18px 30px rgba(255,236,190,0.024), inset 0 -64px 96px rgba(0,0,0,0.82), inset 0 -2px 0 rgba(0,0,0,0.64), 0 24px 54px rgba(0,0,0,0.24);"
  >
    <div
      class="absolute inset-0 rounded-full"
      style="background:
