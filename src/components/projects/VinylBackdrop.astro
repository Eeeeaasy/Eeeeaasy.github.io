        radial-gradient(38% 30% at 90% 53%, rgba(255,232,190,0.085), rgba(255,255,255,0) 70%),
        radial-gradient(54% 28% at 50% 92%, rgba(255,238,204,0.16), rgba(255,255,255,0) 72%);"
