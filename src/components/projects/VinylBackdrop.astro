    <div class="absolute left-1/2 top-1/2 h-[3.8%] w-[3.8%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-zinc-100/95 shadow-inner shadow-black/35" />
    </div>
  </div>
</div>

<style>
  @keyframes projects-vinyl-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  #projects-vinyl-rotor {
    animation: projects-vinyl-spin 12.6s linear infinite;
    animation-play-state: paused;
    transform-origin: 50% 50%;
  }

  #projects-vinyl-cover {
    transition: background-image 220ms ease, filter 220ms ease;
  }
</style>

<script>
  (() => {
    const rotor = document.getElementById("projects-vinyl-rotor");
    const cover = document.getElementById("projects-vinyl-cover");
    if (!rotor || !cover) return;

    const onPlayerStateChange: EventListener = (event) => {
      const customEvent = event as CustomEvent<{ cover?: string; isPlaying?: boolean }>;
      const detail = customEvent && customEvent.detail ? customEvent.detail : {};
      if (typeof detail.cover === "string" && detail.cover.length > 0) {
        cover.style.backgroundImage = `url('${detail.cover}')`;
      }
      rotor.style.animationPlayState = detail.isPlaying ? "running" : "paused";
    };

    window.addEventListener("projects-player-state-change", onPlayerStateChange);
  })();
</script>
