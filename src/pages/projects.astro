---
import Navbar from "../components/home/Navbar";
import ProjectsPageSection from "../components/projects/ProjectsPageSection";
import VinylBackdrop from "../components/projects/VinylBackdrop.astro";
import ProjectsCornerAvatar from "../components/home/ProjectsCornerAvatar";
import ColorButton from "../components/home/ColorButton";
import JellyCursor from "../components/ui/JellyCursor";
import ThemeHeadScript from "../components/ThemeHeadScript.astro";
import "../styles/global.css";
import DynamicProjectHeader from "../components/projects/DynamicProjectHeader";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeHeadScript />
    <title>Demo | Eeeeaasy</title>
  </head>
  <body class="h-screen overflow-hidden bg-white text-neutral-900 antialiased transition-colors duration-500 ease-in-out dark:bg-neutral-950 dark:text-neutral-100">
    <div class="relative h-screen overflow-hidden">
      <div class="pointer-events-none fixed inset-0 z-0 transition-opacity duration-700 bg-[radial-gradient(circle_at_top,rgba(0,0,0,0.03),transparent_35%)] dark:bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_35%)]"></div>

      <VinylBackdrop />

      <Navbar client:load edgeSpread={true} />

      <main class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-12 px-6 pt-28 pb-16 md:px-10 md:pt-32">

        {/* 联动主标题区 */}
        <DynamicProjectHeader client:load />

        <ProjectsPageSection client:idle />
      </main>

      <ProjectsCornerAvatar client:load showAvatar={false} />

      <ColorButton client:idle />
      <JellyCursor client:idle />
    </div>
  </body>
</html>
