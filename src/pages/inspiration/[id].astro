---
import { ClientRouter } from "astro:transitions";
import Navbar from "../../components/home/Navbar";
import ColorButton from "../../components/home/ColorButton";
import JellyCursor from "../../components/ui/JellyCursor";
import InspirationCardEditor from "../../components/inspiration/InspirationCardEditor";
import InspirationPageSection from "../../components/inspiration/InspirationPageSection";
import { INSPIRATION_CARDS, getAdjacentCardIds } from "../../data/inspirationCards";
import "../../styles/global.css";

export function getStaticPaths() {
  return INSPIRATION_CARDS.map((card) => ({
    params: { id: String(card.id) },
  }));
}

const id = Number(Astro.params.id);
const card = INSPIRATION_CARDS.find((item) => item.id === id) ?? INSPIRATION_CARDS[0];
const { prevId, nextId } = getAdjacentCardIds(card.id);
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`Inspiration ${card.id} | Eeeeaasy`}</title>
    <ClientRouter />
  </head>
  <body class="h-screen overflow-hidden bg-white text-neutral-900 antialiased transition-colors duration-500 ease-in-out dark:bg-neutral-950 dark:text-neutral-100">
    <div class="relative h-screen overflow-hidden">
      <div class="pointer-events-none fixed inset-0 z-0 transition-opacity duration-700 bg-[radial-gradient(circle_at_top,rgba(0,0,0,0.03),transparent_35%)] dark:bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_35%)]"></div>

      <Navbar client:load />

      <main class="relative z-10 mx-auto flex h-full w-full max-w-7xl flex-col gap-6 px-6 pt-24 pb-6 md:px-10 md:pt-28 md:pb-8">
        <section class="text-center">
          <p class="text-sm uppercase tracking-[0.25em] opacity-50">Twinkle,Twinkle,little Star</p>
          <h1 class="mt-3 text-4xl font-semibold md:text-5xl">一些灵感</h1>
          <p class="mx-auto mt-4 max-w-2xl opacity-70">
            <span class="dark:hidden">人类灵感迸发时！人类群星闪耀！</span>
            <span class="hidden dark:inline">再有灵感！也要两点前睡觉！</span>
          </p>
        </section>

        <div class="pointer-events-none opacity-90">
          <InspirationPageSection client:load />
        </div>

        <InspirationCardEditor
          client:load
          cardId={card.id}
          defaultTitle={card.label ?? `Card ${card.id}`}
          defaultBody="在这里写下你的灵感内容..."
          notch={card.notch}
          darkLabel={card.darkLabel}
          prevHref={`/inspiration/${prevId}`}
          nextHref={`/inspiration/${nextId}`}
          backHref="/inspiration"
        />
      </main>

      <ColorButton client:load />
      <JellyCursor client:load />
    </div>
  </body>
</html>
