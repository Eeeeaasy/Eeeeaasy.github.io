---
import Navbar from "../components/home/Navbar";
import SkillsSection from "../components/skills/SkillsSection";
import ColorButton from "../components/home/ColorButton";
import JellyCursor from "../components/ui/JellyCursor";
import "../styles/global.css";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Skills | Eeeeaasy</title>
  </head>
  <body class="bg-white text-neutral-900 antialiased transition-colors duration-500 ease-in-out dark:bg-neutral-950 dark:text-neutral-100">
    <div class="relative min-h-screen">
      <div class="pointer-events-none fixed inset-0 z-0 transition-opacity duration-700 bg-[radial-gradient(circle_at_top,rgba(0,0,0,0.03),transparent_35%)] dark:bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_35%)]"></div>

      <Navbar client:load />

      <main class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-12 px-6 pt-28 pb-16 md:px-10 md:pt-32">
        <section class="text-center">
          <p class="text-sm uppercase tracking-[0.25em] opacity-50">Skills</p>
          <h1 class="mt-3 text-4xl font-semibold md:text-5xl">My Technical Playground</h1>
          <p class="mx-auto mt-4 max-w-2xl opacity-70">
            Explore my interactive stack showcase with keyboard-inspired UI, motion, and 3D details.
          </p>
        </section>

        <SkillsSection client:load />
      </main>

      <ColorButton client:load />
      <JellyCursor client:load />
    </div>
  </body>
</html>